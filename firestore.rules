rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isUser(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isDataOwner() {
      return isAuthenticated() && (
        (resource == null && request.resource.data.userId == request.auth.uid) ||
        (resource != null && resource.data.userId == request.auth.uid)
      );
    }

    match /users/{userId} {
      allow read, write: if isUser(userId);
    }

    match /userGoals/{goalId} {
      allow read, write: if isUser(goalId) || isDataOwner();
    }

    match /dailyLogs/{logId} {
      allow read, write: if isDataOwner();
    }

    match /routineDays/{routineId} {
      allow read, write: if isDataOwner();
    }

    match /userInsights/{insightId} {
      allow read, write: if isUser(insightId) || isDataOwner();
    }
  }
}
